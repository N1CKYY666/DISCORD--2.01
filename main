@bot.command()
async def heh(ctx, count_heh=5):
    await ctx.send("he" * count_heh)


def create_voice(text, file_path):
    engine = pyttsx3.init()

    voices = engine.getProperty('voices')
    engine.setProperty('voice', voices[1].id)
    engine.setProperty('rate', 150)
    engine.setProperty('volume', 1)

    engine.save_to_file(text, file_path)
    engine.runAndWait()
    engine.stop()

#the bot will reply with a voice message when the user uses the $say command
@bot.command()
async def say(ctx, *, text):
    if len(text) > 200:
        await ctx.send("Bro, that's too much text!")
        return

    await ctx.send("Wait, I'm learning how to speak because im a goddamned robot...")

    with tempfile.TemporaryDirectory() as temp_dir:
        audio_path = os.path.join(temp_dir, "robot.wav")

        try:
            #asyncio.to_thread is used to run the create_voice function in a separate thread to avoid blocking the main event loop
            await asyncio.to_thread(create_voice, text, audio_path)

            await ctx.send(
                file=discord.File(audio_path, filename="robot.wav")
            )
        except Exception as error:
            print("Voice error:", error)
            await ctx.send("My voice is broken, dude. try again when you pay me.")

def get_me_weather(city : str):
    base_url = f"https://wttr.in/{city}?format=%C|%t"
    response = requests.get(base_url)

    #status
    if response.status_code == 200:
        return response.text.strip()
    
    else:
        return "There was an error retrieving the weather information."


def get_night_weather(city: str):

    base_url = f"https://wttr.in/{city}?format=%m|%S|%s"

    response = requests.get(base_url, timeout=15)

    if response.status_code == 200:
        return response.text.strip()

    else:
        return None
    

moon_images = {
    "🌑": "new_moon.png",
    "🌒": "waxing_crescent.png",
    "🌓": "first_quarter.png",
    "🌔": "waxing_gibbous.png",
    "🌕": "full_moon.png",
    "🌖": "waning_gibbous.png",
    "🌗": "last_quarter.png",
    "🌘": "waning_crescent.png"
}



weather_images = {
    "sunny": "sunny.png",
    "clear": "sunny.png",
    "partly cloudy": "partly_cloudy.png",
    "cloudy": "cloudy.png",
    "overcast": "cloudy.png",
    "rain": "rain.png",
    "light rain": "rain.png",
    "heavy rain": "rain.png",
    "thunderstorm": "thunderstorm.png",
    "snow": "snow.png",
    "windy": "wind.png"
}



@bot.command()
async def night(ctx, *, city: str):

    climate = await asyncio.to_thread(get_night_weather, city)

    if climate is None:
        await ctx.send("The heavens refuse to answer me, mortal.")
        return

    moon, sunrise, sunset = climate.split("|")

    phrases = [
        "The sun is finally leaving. I can visit Mizrak.",
        "Another night, and im quite hungry.",
        "The darkness approaches.",
        "I suppose even the heavens have their schedule."
    ]

    phrase = random.choice(phrases)

    embed = discord.Embed(
        title="─── NIGHTS FORECAST ───",
        description=(
            f"**Location:** {city}\n\n"
            f"**Moon phase:** {moon}\n"
            f"**Sunrise:** {sunrise}\n"
            f"**Sunset:** {sunset}\n\n"
            f"*\"{phrase}\"*"
        ),
        color=0x74459A
    )

    embed.set_footer(
        text="THE REAL OLROX • Night Report For You, Dumbass"
    )

    image_name = moon_images.get(moon)

    if image_name:
        image_path = os.path.join(
            "olrox_all_icons", "images", image_name
        )

        image = discord.File(
            image_path,
            filename=image_name
        )

        embed.set_thumbnail(
            url=f"attachment://{image_name}"
        )

        await ctx.send(embed=embed, file=image)

    else:
        await ctx.send(embed=embed)




@bot.command()
async def weather(ctx, *, city: str):

    climate = await asyncio.to_thread(get_me_weather, city)

    if "|" not in climate:
        await ctx.send("The skies refuse to answer me, mortal.")
        return

    condition, temperature = climate.split("|", 1)

    condition = condition.strip()
    temperature = temperature.strip()

    phrases = [
        "Even the weather is more interesting than you.",
        "Centuries of wisdom, wasted on weather reports.",
        "I suppose you needed me to look at the sky for you.",
        "How delightful. Another day among mortals."
    ]

    phrase = random.choice(phrases)

    embed = discord.Embed(
        title="─── THE FORECAST ───",
        description=(
            f"**Location:** {city}\n\n"
            f"**Weather:** {condition}\n"
            f"**Temperature:** {temperature}\n\n"
            f"*\"{phrase}\"*"
        ),
        color=0x74459A
    )

    embed.set_footer(
        text="THE REAL OLROX • Weather Report... Unfortunately."
    )

    image_name = weather_images.get(condition.lower())

    # Prepare the voice message
    message = f"The weather in {city} is {condition}, {temperature}"
    spoken_message = message.replace("°C", " degrees Celsius")

    with tempfile.TemporaryDirectory() as temp_dir:

        audio_path = os.path.join(temp_dir, "weather.wav")

        if image_name:
            image_path = os.path.join(
                "olrox_all_icons", "images", image_name
            )

            image = discord.File(
                image_path,
                filename=image_name
            )

            embed.set_thumbnail(
                url=f"attachment://{image_name}"
            )

            await ctx.send(embed=embed, file=image)

        else:
            await ctx.send(embed=embed)

        try:
            await asyncio.to_thread(
                create_voice, spoken_message, audio_path
            )

            await ctx.send(
                file=discord.File(
                    audio_path,
                    filename="weather.wav"
                )
            )

        except Exception as error:
            print("Voice error:", error)
            await ctx.send("My voice is broken, mortal.")




bot.run("TOKEN_HERE")
